{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/state-constrained-ir-v0.1.schema.json",
  "title": "State-Constrained Semantic IR v0.1",
  "type": "object",
  "required": [
    "irSchemaVersion",
    "semanticModelVersion",
    "subjects",
    "stateFamilies",
    "claims",
    "events",
    "transitions",
    "effects",
    "capabilities",
    "obligations",
    "authorities",
    "relations",
    "policies",
    "migrations"
  ],
  "properties": {
    "irSchemaVersion": {
      "const": "0.1"
    },
    "semanticModelVersion": {
      "type": "string"
    },
    "semanticHash": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "stateFamilies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateFamily"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authority"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migration"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stateCase": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "deprecated": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "stateFamily": {
      "type": "object",
      "required": [
        "id",
        "name",
        "subject",
        "consequential",
        "cases"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/id"
        },
        "consequential": {
          "type": "boolean"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stateCase"
          }
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "stateFamily",
            "case"
          ],
          "properties": {
            "op": {
              "const": "stateEquals"
            },
            "stateFamily": {
              "$ref": "#/$defs/id"
            },
            "case": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "claim",
            "epistemicState"
          ],
          "properties": {
            "op": {
              "const": "claimStateEquals"
            },
            "claim": {
              "$ref": "#/$defs/id"
            },
            "epistemicState": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "name",
        "subject",
        "protected",
        "epistemicStates"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/id"
        },
        "protected": {
          "type": "boolean"
        },
        "epistemicStates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "trustedProducers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "name",
        "trusted"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "trusted": {
          "type": "boolean"
        },
        "trustedProducer": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "required": [
        "stateFamily",
        "case"
      ],
      "properties": {
        "stateFamily": {
          "$ref": "#/$defs/id"
        },
        "case": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "request"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "event"
          ],
          "properties": {
            "kind": {
              "const": "event"
            },
            "event": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "transition": {
      "type": "object",
      "required": [
        "id",
        "name",
        "subject",
        "trigger",
        "requires",
        "produces"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/id"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "produces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/production"
          }
        },
        "authority": {
          "$ref": "#/$defs/id"
        },
        "effect": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "effectOutcome": {
      "type": "object",
      "required": [
        "id",
        "name",
        "event"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "event": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": [
        "id",
        "name",
        "implementationPort",
        "outcomes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "implementationPort": {
          "type": "string"
        },
        "idempotencyRequired": {
          "type": "boolean",
          "default": false
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effectOutcome"
          }
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "name",
        "requires",
        "binds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "binds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": [
        "id",
        "name",
        "when",
        "satisfiedWhen"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "satisfiedWhen": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "allowedRoles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "name",
        "fromSubject",
        "toSubject"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "fromSubject": {
          "$ref": "#/$defs/id"
        },
        "toSubject": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "policyRule": {
      "type": "object",
      "required": [
        "id",
        "target",
        "kind",
        "condition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "addRequirement",
            "replaceRequirement"
          ]
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "rules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policyRule"
          }
        }
      },
      "additionalProperties": false
    },
    "migrationDisposition": {
      "type": "object",
      "required": [
        "dependencyId",
        "targets"
      ],
      "properties": {
        "dependencyId": {
          "$ref": "#/$defs/id"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "case",
              "disposition"
            ],
            "properties": {
              "case": {
                "$ref": "#/$defs/id"
              },
              "disposition": {
                "enum": [
                  "include",
                  "exclude",
                  "replace",
                  "review"
                ]
              },
              "replacementSemanticId": {
                "$ref": "#/$defs/id"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "sourceCases",
        "targetCases",
        "redistributions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "add",
            "remove",
            "rename",
            "split",
            "merge",
            "replace",
            "deprecate"
          ]
        },
        "sourceCases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "targetCases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "redistributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/migrationDisposition"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}